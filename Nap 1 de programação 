        "class Filme:\n",
        "    def __init__(self, id_obra, titulo, diretor, ano_lancamento, duracao_minutos, genero, faixa_etaria, pais, idioma, orcamento_milhoes):\n",
        "        self.id_obra = id_obra\n",
        "        self.titulo = titulo\n",
        "        self.diretor = diretor\n",
        "        self.ano_lancamento = ano_lancamento\n",
        "        self.duracao_minutos = duracao_minutos\n",
        "        self.genero = genero\n",
        "        self.classificacao_etaria = faixa_etaria\n",
        "        self.pais = pais\n",
        "        self.idioma = idioma\n",
        "        self.orcamento_milhoes = orcamento_milhoes\n",
        "\n",
        "    def presentar_dados(self):\n",
        "        print(f\"Obra: {self.titulo}\")\n",
        "        print(f\"Diretor: {self.diretor}\")\n",
        "        print(f\"Ano: {self.ano_lancamento} | Gênero: {self.genero}\")\n",
        "        print(f\"Duração: {self.duracao_minutos} min | Classificação: {self.classificacao_etaria}\")\n",
        "\n",
        "    def calcular_nota_comunidade(self):\n",
        "        return 3.0\n",
        "\n",
        "\n",
        "class CurtaMetragem(Filme):\n",
        "    def __init__(self, id_obra, titulo, diretor, ano_lancamento, duracao_minutos, genero, faixa_etaria, pais, idioma, orcamento_milhoes, quantidade_reviews_usuario, media_estrelas_usuario, favorito_do_perfil):\n",
        "        super().__init__(id_obra, titulo, diretor, ano_lancamento, duracao_minutos, genero, faixa_etaria, pais, idioma, orcamento_milhoes)\n",
        "        self.quantidade_reviews_usuario = quantidade_reviews_usuario\n",
        "        self.media_estrelas_usuario = media_estrelas_usuario\n",
        "        self.favorito_do_perfil = favorito_do_perfil\n",
        "\n",
        "    def calcular_nota_comunidade(self):\n",
        "        nota_base = super().calcular_nota_comunidade()\n",
        "        bonus_estrelas = (self.media_estrelas_usuario / 5.0) * 1.5\n",
        "        bonus_engajamento = min(0.5, self.quantidade_reviews_usuario / 1000.0)\n",
        "        nota_final = min(5.0, nota_base + bonus_estrelas + bonus_engajamento)\n",
        "        return round(nota_final, 1)\n",
        "\n",
        "\n",
        "class Documentario(Filme):\n",
        "    def __init__(self, id_obra, titulo, diretor, ano_lancamento, duracao_minutos, genero, faixa_etaria, pais, idioma, orcamento_milhoes, tema, arquivos_historicos_reais, impacto):\n",
        "        super().__init__(id_obra, titulo, diretor, ano_lancamento, duracao_minutos, genero, faixa_etaria, pais, idioma, orcamento_milhoes)\n",
        "        self.tema = tema\n",
        "        self.arquivos_historicos_reais = arquivos_historicos_reais\n",
        "        self.impacto = impacto\n",
        "\n",
        "    def calcular_nota_comunidade(self):\n",
        "        nota_base = super().calcular_nota_comunidade()\n",
        "        fator_impacto = self.impacto * 0.4\n",
        "        bonus_arquivo = 0.5 if self.arquivos_historicos_reais else 0.0\n",
        "        nota_final = min(5.0, nota_base + fator_impacto + bonus_arquivo)\n",
        "        return round(nota_final, 1)\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    print(\"=\" * 45)\n",
        "    print(\"          CATÁLOGO DE FILMES\")\n",
        "    print(\"=\" * 45)\n",
        "\n",
        "    catalogo_filmes = []\n",
        "\n",
        "    diretores_filmes = [\"Martin Scorsese\", \"Greta Gerwig\", \"Christopher Nolan\", \"Bong Joon-ho\", \"Celine Song\"]\n",
        "    generos_filmes = [\"Drama\", \"Romance\", \"Ficção Científica\", \"Thriller\", \"Comédia Sombria\"]\n",
        "\n",
        "    for i in range(1, 21):\n",
        "        id_obra = f\"FILM-{i:03d}\"\n",
        "        titulo = f\"CineClub Curta {i}\"\n",
        "        diretor = diretores_filmes[i % len(diretores_filmes)]\n",
        "        ano = 2010 + (i % 15)\n",
        "        duracao = 15 + i\n",
        "        genero = generos_filmes[i % len(generos_filmes)]\n",
        "        faixa = \"14 anos\" if i % 2 == 0 else \"18 anos\"\n",
        "        orcamento = 15.0 + (i * 8)\n",
        "\n",
        "        filme = CurtaMetragem(\n",
        "            id_obra, titulo, diretor, ano, duracao, genero, faixa,\n",
        "            \"EUA\" if i % 2 == 0 else \"França\",\n",
        "            \"Inglês\", orcamento,\n",
        "            150 + (i * 45),\n",
        "            3.0 + ((i % 5) * 0.4),\n",
        "            True if i % 3 == 0 else False\n",
        "        )\n",
        "        catalogo_filmes.append(filme)\n",
        "\n",
        "    diretores_docs = [\"Werner Herzog\", \"Agnes Varda\", \"Joshua Oppenheimer\", \"Ava DuVernay\"]\n",
        "    temas_docs = [\"Cultura Pop\", \"Meio Ambiente\", \"História Contemporânea\", \"Música Independente\"]\n",
        "\n",
        "    for i in range(1, 21):\n",
        "        id_obra = f\"DOC-{i:03d}\"\n",
        "        tema = temas_docs[i % len(temas_docs)]\n",
        "        titulo = f\"Documentário sobre {tema} {i}\"\n",
        "        diretor = diretores_docs[i % len(diretores_docs)]\n",
        "        ano = 2012 + (i % 13)\n",
        "        duracao = 80 + (i * 3)\n",
        "        genero = \"Documentário\"\n",
        "        faixa = \"Livre\" if i % 2 == 0 else \"12 anos\"\n",
        "        orcamento = 2.0 + (i * 2)\n",
        "\n",
        "        doc = Documentario(\n",
        "            id_obra, titulo, diretor, ano, duracao, genero, faixa,\n",
        "            \"Reino Unido\" if i % 2 == 0 else \"Brasil\",\n",
        "            \"Português\" if i % 2 == 0 else \"Inglês\",\n",
        "            orcamento, tema,\n",
        "            True if i % 2 == 0 else False,\n",
        "            3 + (i % 3)\n",
        "        )\n",
        "        catalogo_filmes.append(doc)\n",
        "\n",
        "    curtas = [obra for obra in catalogo_filmes if isinstance(obra, CurtaMetragem)]\n",
        "    documentarios = [obra for obra in catalogo_filmes if isinstance(obra, Documentario)]\n",
        "\n",
        "    print(f\"\\nTotal de obras: {len(catalogo_filmes)}\")\n",
        "    print(f\"Curtas-metragens: {len(curtas)}\")\n",
        "    print(f\"Documentários: {len(documentarios)}\")\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 45)\n",
        "    print(\"CURTAS-METRAGENS\")\n",
        "    print(\"=\" * 45)\n",
        "    for obra in curtas:\n",
        "        obra.presentar_dados()\n",
        "        print(f\"Nota da comunidade: {obra.calcular_nota_comunidade()}/5.0\")\n",
        "        print(\"-\" * 45)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 45)\n",
        "    print(\"DOCUMENTÁRIOS\")\n",
        "    print(\"=\" * 45)\n",
        "    for obra in documentarios:\n",
        "        obra.presentar_dados()\n",
        "        print(f\"Nota da comunidade: {obra.calcular_nota_comunidade()}/5.0\")\n",
